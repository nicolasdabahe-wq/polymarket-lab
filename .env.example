# --- Modo de ejecución -------------------------------------------------------
# El bot SIEMPRE arranca en paper trading. Para operar con dinero real hay que
# poner exactamente: LIVE_TRADING=I_UNDERSTAND_THE_RISKS
# Cualquier otro valor (o ausencia) => paper.
LIVE_TRADING=

# --- Claves (solo necesarias en modo real; NUNCA commitear) ------------------
# Clave privada exportada desde Polymarket (perfil → Settings → Export Private Key).
POLYMARKET_PRIVATE_KEY=
# Dirección de tu wallet de Polymarket (perfil → el 0x… que aparece bajo tu nombre).
POLYMARKET_PROXY_ADDRESS=
# Tipo de firma según tu wallet de Polymarket:
#   3 = cuentas de la app actual (wallet contrato nuevo, EIP-1271) — lo usual hoy
#   1 = cuentas viejas con login por email (proxy clásico)
#   2 = login con MetaMask/browser wallet (Gnosis Safe)
#   0 = EOA directa (API pura)
# Si live-check muestra Saldo 0.00 con fondos en la app, probá otro tipo.
POLYMARKET_SIGNATURE_TYPE=3

# --- LLM para intel/ (opcional; sin clave se usa el fallback por keywords) ---
ANTHROPIC_API_KEY=

# --- Telegram (opcional) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rutas -------------------------------------------------------------------
# Directorio de datos (SQLite, estado). Por defecto ./var
PMBOT_VAR_DIR=
# Ruta al config.yaml. Por defecto ./config.yaml
PMBOT_CONFIG=
